{
  "private": true,
  "name": "masterportfolio-devsculptedby-aayushmishra",
  "version": "1.0.0",
  "description": "Portfolio of Aayush Mishra, Senior SDET & QA Lead",
  "author": "Aayush Mishra",
  "license": "MIT",
  "homepage": "https://aayushmishra.engineer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aayush-Mishraa/MasterPortfolio-DevSculptedBy-AayushMishra.git"
  },
  "scripts": {
    "build": "react-scripts build",
    "prebuild": "node scripts/automation/fetch_projects_snapshot.mjs && node scripts/automation/build_bug_log.mjs",
    "eject": "react-scripts eject",
    "start": "react-scripts start",
    "test": "react-scripts test",
    "fetch-github-data": "node scripts/automation/git_data_fetcher.mjs",
    "fetch-projects": "node scripts/automation/fetch_projects_snapshot.mjs",
    "auto-refresh": "node scripts/automation/auto-refresh.mjs",
    "spell": "cspell --no-progress \"src/portfolio.js\" \"src/pages/**/*.js\" \"src/data/*.js\" \"src/components/{CreativeFooter,header,seoHeader,topButton,themeSelector}/*.js\" \"public/index.html\" \"public/manifest.json\" \"public/robots.txt\" \"public/llms.txt\""
  },
  "dependencies": {
    "@studio-freight/lenis": "^1.0.19",
    "apollo-boost": "^0.4.4",
    "baseui": "^9.65.3",
    "chart.js": "^2.9.3",
    "gsap": "^3.13.0",
    "node-fetch": "^2.6.0",
    "prettier-package-json": "^2.1.3",
    "react": "^16.10.2",
    "react-bootstrap": "^1.0.0-beta.16",
    "react-chartjs-2": "^2.9.0",
    "react-dom": "^16.10.2",
    "react-helmet": "^6.1.0",
    "react-is": "^19.1.1",
    "react-reveal": "^1.2.2",
    "react-router-dom": "^5.1.2",
    "react-scripts": "3.2.0",
    "styled-components": "^5.1.1",
    "styletron-engine-atomic": "^1.4.6",
    "styletron-react": "^5.2.7",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "cspell": "^8.19.4",
    "dotenv": "^6.2.0",
    "husky": "^4.2.5",
    "lint-staged": "^10.2.11",
    "prettier": "2.0.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.json": "prettier-package-json --write",
    "*.{js,css,md}": "prettier --write"
  }
}
