# aayushmishra.engineer on Hostinger (LiteSpeed, Apache-compatible .htaccess).
#
# Every page is prerendered at build time (scripts/prerender): "/" is
# index.html, every other route is _pages/<route>.html. A URL that is neither a
# file nor one of those pages gets a real 404 (404.html). /api and /admin
# answer for themselves (their own .htaccess).
#
# After changing this file: flush the Hostinger CDN cache (hPanel → Performance
# → CDN) and check with ?v=<random>.

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One host: www → apex (http → https is done by the CDN)
  RewriteCond %{HTTP_HOST} ^www\.aayushmishra\.engineer$ [NC]
  RewriteRule ^ https://aayushmishra.engineer%{REQUEST_URI} [R=301,L]

  # The PHP API and the admin area
  RewriteRule ^(api|admin)(/|$) - [L]

  # Prerendered files are only reachable through their clean URLs
  RewriteCond %{THE_REQUEST} \s/+_pages/ [NC]
  RewriteRule ^ - [F]

  # One home page: /home → /
  RewriteRule ^home/?$ https://aayushmishra.engineer/ [R=301,L]

  # F10: Projects and Open Source moved under Work (query string kept)
  RewriteRule ^projects/?$ https://aayushmishra.engineer/work [R=301,L]
  RewriteRule ^opensource/?$ https://aayushmishra.engineer/work/open-source [R=301,L]

  # Old channel name
  RewriteRule ^universe/radio/?$ https://aayushmishra.engineer/universe/music [R=301,L]

  # No trailing slash on pages: /contact/ → /contact
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://aayushmishra.engineer/$1 [R=301,L]

  # Real files (scripts, styles, images, data, robots.txt, the tool guides)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Prerendered pages. A name with no file (an unknown repo or channel) is a 404.
  RewriteRule ^(experience|education|automation-arsenal|work|services|about|hire-me|contact|universe|products|free-tools|starter-kit|mentoring|ask)$ _pages/$1.html [L]
  RewriteRule ^hire-me/(kit)$ _pages/hire-me/$1.html [L]
  RewriteRule ^free-tools/([a-z0-9-]+)$ _pages/free-tools/$1.html [L]
  RewriteRule ^free-tools/site-scanner/(report)$ _pages/free-tools/site-scanner/$1.html [L]
  RewriteRule ^services/([a-z0-9-]+)$ _pages/services/$1.html [L]
  RewriteRule ^work/(open-source)$ _pages/work/$1.html [L]
  RewriteRule ^projects/([A-Za-z0-9._-]+)$ _pages/projects/$1.html [L]
  RewriteRule ^universe/([a-z0-9-]+)$ _pages/universe/$1.html [L]

  # The intro replay is a client-side route on top of the home page
  RewriteRule ^splash$ index.html [L]

  # Anything else: no rewrite, so the server answers 404 with /404.html
</IfModule>

<IfModule mod_headers.c>
  # Pages revalidate on every visit, so a deploy shows up at once
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # The GitHub snapshot is refreshed by the scheduled build
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
  # Favicons: always revalidate (they were stuck in caches before)
  <FilesMatch "^(favicon.*|apple-icon.*|android-icon.*|ms-icon.*)\.(ico|png)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive on
  # Hashed file names (static/js, static/css, static/media) never change
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
