","verified":false,"url":"https://github.com/Aayush-Mishraa/BankAPI-SecureFlow-Automation-Framework/commit/6b813636aae445904cc99bd62760332504f72e58"},{"sha":"5e2d3d5323e4adca0dbe7c552f151dd099a69f53","message":"Some correction","date":"2025-10-05T17:21:21Z","author":"Ayush Mishra","login":"Aayush-Mishraa","avatar":"https://avatars.githubusercontent.com/u/89012492?v=4","verified":false,"url":"https://github.com/Aayush-Mishraa/BankAPI-SecureFlow-Automation-Framework/commit/5e2d3d5323e4adca0dbe7c552f151dd099a69f53"},{"sha":"3da3c011470fb297da9556365b9cf1402261ccb5","message":"Base Code","date":"2025-10-05T17:16:38Z","author":"Ayush Mishra","login":"Aayush-Mishraa","avatar":"https://avatars.githubusercontent.com/u/89012492?v=4","verified":false,"url":"https://github.com/Aayush-Mishraa/BankAPI-SecureFlow-Automation-Framework/commit/3da3c011470fb297da9556365b9cf1402261ccb5"}],"readmeHtml":"<div id=\"readme\" class=\"md\" data-path=\"README.md\"><article class=\"markdown-body entry-content container-lg\" itemprop=\"text\"><div class=\"markdown-heading\" dir=\"auto\"><h1 class=\"heading-element\" dir=\"auto\">🧩 E2E REST API Automation Framework (Rest Assured + Java)</h1><a id=\"user-content--e2e-rest-api-automation-framework-rest-assured--java\" class=\"anchor\" aria-label=\"Permalink: 🧩 E2E REST API Automation Framework (Rest Assured + Java)\" href=\"#-e2e-rest-api-automation-framework-rest-assured--java\"><svg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"><path d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.7