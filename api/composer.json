{
  "name": "aayushmishra/site-api",
  "description": "The PHP endpoints behind aayushmishra.engineer (contact form, newsletter, health).",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-pdo": "*",
    "anthropic-ai/sdk": "^0.54.0",
    "guzzlehttp/guzzle": "^7.9",
    "phpmailer/phpmailer": "^6.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Site\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Site\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.1.0"
    },
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
